{
	"schemaVersion": 1,
	"id": "nofingerprint",
	"version": "${version}",
	"name": "NoFingerprint",
	"description": "Client-side Fabric privacy mod that reduces unnecessary client fingerprinting and information disclosure to Minecraft servers. Independently maintained GPL-3.0 fork of OpSec by aurickk. Public beta: not undetectable, not an anti-cheat bypass, and not a guarantee of anonymity.",
	"authors": [
		"dimaniojk"
	],
	"contributors": [
		"Aurick"
	],
	"contact": {
		"homepage": "https://github.com/dimaniojk/NoFingerprint",
		"sources": "https://github.com/dimaniojk/NoFingerprint",
		"issues": "https://github.com/dimaniojk/NoFingerprint/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/nofingerprint/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.dimaniojk.nofingerprint.NoFingerprintClient"
		],
		"modmenu": [
			"io.github.dimaniojk.nofingerprint.config.NoFingerprintModMenuIntegration"
		],
		"mixinsquared": [
			"io.github.dimaniojk.nofingerprint.mixin.MeteorMixinCanceller"
		]
	},
	"mixins": [
		{
			"config": "nofingerprint.client.mixins.json",
			"environment": "client"
		}
	],
	"breaks": {
		"ichor": "*",
		"labymod": "*",
		"autismsexdefender": "*"
	},
	"depends": {
		"fabricloader": ">=0.14.0",
		"minecraft": "${minecraft_version_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
